# https://huggingface.co/settings/tokens (read access is enough for Inference API)
HF_TOKEN=hf_paste_your_token_here

# Optional: override chat model (must be supported for your HF Inference providers)
# HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional: reply style — higher = a bit more varied wording (default ~0.38 in code)
# RAG_TEMPERATURE=0.3

# CORS: comma-separated origins (Vercel frontend). Use * for local dev only.
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Build / run index on startup (Render, etc.)
# AUTO_INGEST_ON_STARTUP=true
